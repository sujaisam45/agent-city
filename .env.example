# Copy this file to ".env" and fill in your own values. Never share or commit .env.
COMINTY_API_KEY=paste-your-api-key-here
COMINTY_USER_ID=user_xxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your City Planner agent id, from platform.cominty.ai/agents
COMINTY_AGENT_ID=paste-your-agent-id-here
COMINTY_MEMORY_NAMESPACE=city-planner
# Set to 1 to force the offline scripted demo even with a key
AGENT_CITY_MOCK=0
AGENT_CITY_PASSCODE=
